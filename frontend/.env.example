# Where the Laravel API lives. Leave unset in development: Vite proxies /api to the backend below.
# VITE_API_URL=https://api.example.com/api/v1

# Backend the development proxy forwards /api to (default http://127.0.0.1:8000, i.e. `php artisan serve`).
# MUNDALINQ_BACKEND_URL=http://127.0.0.1:8000
