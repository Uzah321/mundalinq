APP_NAME=MundaLinq
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=mundalinq
DB_USERNAME=mundalinq
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# MundaLinq (all optional; defaults shown)
SMS_DRIVER=log
MUNDALINQ_REQUIRE_PRODUCT_APPROVAL=false
MUNDALINQ_LISTING_TTL_DAYS=30
MUNDALINQ_TOKEN_TTL_DAYS=90
PAYMENT_PROVIDER=sandbox
SANDBOX_WEBHOOK_SECRET=change-me
MUNDALINQ_COMMISSION_RATE=0.05
MUNDALINQ_ORDER_CONFIRM_MINUTES=240
MUNDALINQ_ORDER_PAY_MINUTES=180
MUNDALINQ_DISPUTE_WINDOW_HOURS=48
MUNDALINQ_REVIEW_WINDOW_DAYS=30
MUNDALINQ_PAYOUT_HOLD_HOURS=24
MUNDALINQ_STAFF_TWO_FACTOR=true
MUNDALINQ_EVIDENCE_DISK=local
SANDBOX_REFUNDS_FAIL=false
